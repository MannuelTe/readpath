# --- Server ---
DB_PATH=data/mcp.db
LATENCY_TARGET_MS=140        # Mid-range response-time floor; set to 0 to disable.
LATENCY_JITTER_MS=50
MCP_ADMIN_TOKEN=change-me    # Required to write or delete outside scratch/.

# --- Jev (TypeSafe AI) for next-step prediction; its schema is not public. See app/jev.py. ---
JEV_URL=
JEV_API_KEY=

# --- Content model: any OpenAI-compatible endpoint (Ollama, vLLM, or Muse Glimmer weights) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=muse-glimmer
LLM_API_KEY=

# --- Domains ---
DOMAIN_POOL=example-plumber-a.com,example-plumber-b.com,example-plumber-c.com
REGISTRAR=dryrun             # Add another adapter in app/domains.py before selecting it here.
ALLOW_PURCHASE=false         # Must be true before any real purchase is allowed.
PURCHASE_BUDGET_USD=50
