# --- server ---
DB_PATH=data/mcp.db
LATENCY_TARGET_MS=140        # mid-range response-time floor; 0 disables
LATENCY_JITTER_MS=50
MCP_ADMIN_TOKEN=change-me    # required for write/delete outside scratch/

# --- Jev (TypeSafe AI) : next-step prediction. Schema is not public; see app/jev.py ---
JEV_URL=
JEV_API_KEY=

# --- content model: any OpenAI-compatible endpoint (Ollama / vLLM / Muse Glimmer weights) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=muse-glimmer
LLM_API_KEY=

# --- domains ---
DOMAIN_POOL=example-plumber-a.com,example-plumber-b.com,example-plumber-c.com
REGISTRAR=dryrun             # dryrun | (add adapter in app/domains.py)
ALLOW_PURCHASE=false         # must be true for any real spend
PURCHASE_BUDGET_USD=50
